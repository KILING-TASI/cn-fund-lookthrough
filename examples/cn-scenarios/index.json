{
  "batch": "cn-scenarios-20261010",
  "sampleType": "synthetic-teaching-only",
  "inputSchema": "cnlookthrough-nodes-v1",
  "rulesVersion": "disclosed-paths-2",
  "toolVersion": "cn-fund-lookthrough-0.2.0.dev1",
  "conversionRulesVersion": "complete-equity-all-classes-nav-2",
  "groups": 3,
  "cases": [
    {
      "id": "quarter-top10",
      "group": "disclosure-scope",
      "input": "examples/cn-scenarios/quarter-top10.json",
      "expected": {
        "knownExposure": 0.4,
        "unknownExposure": 0.6,
        "unmappedStockIssuerExposure": 0.4,
        "pathCount": 10
      },
      "rationale": "季报十大股票每项4%净资产，合计40%；其余60%未知，不认定现金，也不按40%重归一。日期为假设。"
    },
    {
      "id": "complete-equity",
      "group": "disclosure-scope",
      "input": "examples/cn-scenarios/complete-equity.json",
      "expected": {
        "knownExposure": 0.7,
        "unknownExposure": 0.3,
        "unmappedStockIssuerExposure": 0.7,
        "pathCount": 2
      },
      "rationale": "虚构完整股票范围占净资产70%，非股票30%仍未知；完整股票不等于完整资产穿透。",
      "entry": "to-spec",
      "asOf": "2026-10-10"
    },
    {
      "id": "top10-conversion",
      "group": "disclosure-scope",
      "input": "examples/cn-scenarios/top10-conversion.json",
      "expected": {
        "conversionErrorContains": "限定完整股票表"
      },
      "rationale": "现有转换仅支持限定完整股票/全份额净资产；显式错误不得被转换丢弃。",
      "entry": "to-spec",
      "asOf": "2026-10-10"
    },
    {
      "id": "single-class-conversion",
      "group": "disclosure-scope",
      "input": "examples/cn-scenarios/single-class-conversion.json",
      "expected": {
        "conversionErrorContains": "基金全部份额合计口径"
      },
      "rationale": "现有转换仅支持限定完整股票/全份额净资产；显式错误不得被转换丢弃。",
      "entry": "to-spec",
      "asOf": "2026-10-10"
    },
    {
      "id": "equity-denominator-conversion",
      "group": "disclosure-scope",
      "input": "examples/cn-scenarios/equity-denominator-conversion.json",
      "expected": {
        "conversionErrorContains": "基金净资产分母"
      },
      "rationale": "现有转换仅支持限定完整股票/全份额净资产；显式错误不得被转换丢弃。",
      "entry": "to-spec",
      "asOf": "2026-10-10"
    },
    {
      "id": "ac-explicit-shared-snapshot",
      "group": "ac-identity",
      "input": "examples/cn-scenarios/ac-explicit-shared-snapshot.json",
      "expected": {
        "knownExposure": 0.5,
        "unknownExposure": 0.5,
        "issuerExposure": {
          "教学公司": 0.5
        },
        "pathWeights": {
          "教学A类|fund>CN-equity:TEACHING-A": 0.2,
          "教学C类|fund>CN-equity:TEACHING-A": 0.3
        }
      },
      "rationale": "账户市值12000/30000=40%、18000/30000=60%；不是10000:20000份额权重。显式关联同快照仍保留两根路径；不证明收益/费用相同。"
    },
    {
      "id": "ac-name-only-not-merged",
      "group": "ac-identity",
      "input": "examples/cn-scenarios/ac-name-only-not-merged.json",
      "expected": {
        "knownExposure": 0.32,
        "unknownExposure": 0.68,
        "pathWeights": {
          "教学A类|fund>CN-equity:TEACHING-A": 0.2,
          "教学C类|same-name-other>CN-equity:TEACHING-A": 0.12
        }
      },
      "rationale": "名称相同不能替代关系证据；现有显式节点各走自己的快照，0.4×0.5+0.6×0.2=0.32。"
    },
    {
      "id": "ah-same-name-unmapped",
      "group": "ah-identity",
      "input": "examples/cn-scenarios/ah-same-name-unmapped.json",
      "expected": {
        "knownExposure": 0.5,
        "unknownExposure": 0.5,
        "unmappedStockIssuerExposure": 0.5,
        "issuerExposure": {},
        "effectiveMappedEquityIssuers": null,
        "securityExposure": {
          "CN-equity:TEACHING-AH": 0.3,
          "HK-equity:TEACHING-AH": 0.2
        }
      },
      "rationale": "A/H证券名称相同、排序合并都不是证券合并或发行人认证依据；公司未映射保持未知。"
    },
    {
      "id": "ah-explicit-issuer",
      "group": "ah-identity",
      "input": "examples/cn-scenarios/ah-explicit-issuer.json",
      "expected": {
        "knownExposure": 0.5,
        "unknownExposure": 0.5,
        "unmappedStockIssuerExposure": 0,
        "issuerExposure": {
          "显式教学发行人": 0.5
        },
        "effectiveMappedEquityIssuers": 1,
        "securityExposure": {
          "CN-equity:TEACHING-AH": 0.3,
          "HK-equity:TEACHING-AH": 0.2
        }
      },
      "rationale": "有显式教学发行人依据才能在公司层汇总0.5；两证券0.3/0.2保持分开。1只公司仅限已映射股票子集。"
    }
  ],
  "officialEvidence": "examples/cn-scenarios/official-evidence.json",
  "reuse": [
    "examples/scenarios/fof-shared-etf.json",
    "examples/scenarios/future-disclosure.json",
    "examples/scenarios/publication-at-cutoff.json",
    "examples/scenarios/wrong-denominator.json"
  ]
}
